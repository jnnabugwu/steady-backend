# Names only. Real values live in the Vercel project's environment variables
# (Settings -> Environment Variables), per environment. Locally:
#   vercel env pull .env.local
# See README.md, "Environment variables".

# Kill switch: the coach answers only when this is exactly "true".
COACH_ENABLED=

ANTHROPIC_API_KEY=

# Set by the Upstash for Redis integration from the Vercel Marketplace.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are read first if set.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Team id + bundle id. Defaults to UXZV3C926U.com.jmagic.steady.
APP_ATTEST_APP_ID=
# production | development (which App Attest AAGUID is accepted).
APP_ATTEST_ENV=

# Requests per attested device per UTC day, and across all devices.
COACH_DAILY_LIMIT=
COACH_GLOBAL_DAILY_LIMIT=

# Development and Preview only. Never set in Production.
COACH_DEV_BYPASS_TOKEN=
